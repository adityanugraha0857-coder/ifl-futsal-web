PORT=3000
NODE_ENV=development
# Ganti dengan nilai acak panjang minimal 32 karakter. Jangan gunakan contoh ini di production.
SESSION_SECRET=ISI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
# Isi kredensial milik sendiri sebelum menjalankan npm run init-admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Kosongkan untuk SQLite lokal, atau isi dengan connection string Supabase Postgres.
DATABASE_URL=
# Verifikasi TLS aktif secara default. Isi DATABASE_SSL_CA hanya jika memakai CA khusus.
DATABASE_SSL=true
DATABASE_SSL_CA=
